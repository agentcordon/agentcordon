# AgentCordon — environment variables
#
# Copy this file to .env and edit. Every variable is optional: the server
# generates its own secrets on first run.
#
# This file carries the variables a deployment usually sets. The complete
# reference — every variable for the server, the broker and the CLI, with its
# default, its clamps and what reads it — is docs/configuration.md. Where the
# two disagree, docs/configuration.md is the one written from the code.

# ── Server ──────────────────────────────────────────────────────────────────

# Address and port the server binds. This is the server's listen setting.
AGTCRDN_LISTEN_ADDR=0.0.0.0:3140

# Host-side port for the shipped docker-compose.yml port mapping
# ("${AGTCRDN_PORT:-3140}:3140"). The server binary does NOT read this — a
# plain `docker run` or a bare binary ignores it. Use AGTCRDN_LISTEN_ADDR to
# change the port the server itself listens on.
AGTCRDN_PORT=3140

# The URL your users reach this server on, e.g. https://agentcordon.example.com.
# Everything absolute the server hands out is built from it: the RFC 8628 device
# flow's activation URL that `agentcordon register` prints, the OAuth2 MCP
# callback redirect URI, and the `GET /install.sh` script. Leave it unset and
# the fallbacks differ, neither of them good — the activation URL becomes
# "http://" + AGTCRDN_LISTEN_ADDR, which in a container is http://0.0.0.0:3140,
# an address no browser can open. Set it before anyone enrolls a workspace.
# See docs/configuration.md#agtcrdn_base_url-and-its-two-fallbacks.
AGTCRDN_BASE_URL=

# SQLite database path. SQLite is the only storage backend; the PostgreSQL one
# was removed in 0.4.0, and AGTCRDN_DB_TYPE / AGTCRDN_DB_URL are no longer read
# — a server started with either set refuses to boot.
AGTCRDN_DB_PATH=./data/agent-cordon.db

# Replica guard. The server keeps policy, rate-limit and SSE state in memory, so
# a second process over the same SQLite file enforces a different picture of the
# world. Startup takes an advisory lock on <db path>.lock and refuses to start
# when another process holds it. Values: single (default) | unsafe-shared.
AGTCRDN_REPLICA_MODE=single

# ── Secrets and bootstrap ───────────────────────────────────────────────────

# Master encryption key (auto-generated into <db dir>/.secret if empty).
# Minimum 16 characters. A secret carrying at least 32 bytes of random material
# is used as-is; anything weaker is stretched with Argon2id against a salt
# persisted at <db dir>/.master-salt. Set and persist this in production.
# See docs/master-key.md.
AGTCRDN_MASTER_SECRET=

# Version number of AGTCRDN_MASTER_SECRET. Every encrypted row records the
# version it was sealed under. Leave at 1 until the first rotation.
AGTCRDN_MASTER_KEY_VERSION=1

# The secret for version AGTCRDN_MASTER_KEY_VERSION - 1. Set only during a
# rotation, so rows sealed under the old secret still open until
# POST /api/v1/admin/rotate-key has re-sealed them; then remove it.
# Must differ from AGTCRDN_MASTER_SECRET.
AGTCRDN_PREVIOUS_MASTER_SECRET=

# HKDF salt override, applied to the current and the previous master secret
# alike. Unset, each secret derives its own salt — the safe default. Set it and
# you must keep setting it, including through a rotation.
AGTCRDN_KDF_SALT=

# Argon2id cost for password hashing, secret hashing, and master-secret
# stretching. Defaults are the production values below; lower them only for
# constrained hardware, never for convenience.
AGTCRDN_ARGON2_M_COST_KIB=65536           # Memory cost in KiB (default: 65536 = 64 MiB)
AGTCRDN_ARGON2_T_COST=3                   # Iterations (default: 3)
AGTCRDN_ARGON2_P_COST=4                   # Lanes (default: 4)

AGTCRDN_ROOT_USERNAME=root                # Bootstrap admin username (default: root)
AGTCRDN_ROOT_PASSWORD=                    # Bootstrap admin password (generated and printed once on first boot)

# ── Logging ─────────────────────────────────────────────────────────────────
AGTCRDN_LOG_LEVEL=info                    # trace, debug, info, warn, error (the CLI defaults to warn)
AGTCRDN_LOG_FORMAT=json                   # json or pretty

# ── Sessions and limits ─────────────────────────────────────────────────────
AGTCRDN_SESSION_TTL=28800                 # Admin session TTL in seconds (default: 8 hours)
AGTCRDN_AUTH_CODE_TTL=600                 # OAuth authorization code TTL in seconds
AGTCRDN_DEVICE_CODE_TTL_SECS=600          # Device code TTL in seconds (clamped 30–3600)
AGTCRDN_DEVICE_CODE_POLL_INTERVAL_SECS=5  # Device flow poll interval (clamped 1–60)
AGTCRDN_SESSION_CLEANUP_INTERVAL=300      # Expired-session sweep interval in seconds (floor 10)

# Trust X-Forwarded-For as the client address for per-address limits (login
# lockout, device-code approval). Only behind a reverse proxy that overwrites
# the header. See docs/deployment.md#tls-and-the-reverse-proxy.
AGTCRDN_TRUST_FORWARDED_HEADERS=false

# ── Proxy ───────────────────────────────────────────────────────────────────
# Turns the SSRF guard OFF — not just the loopback rule. With this set, every
# private and reserved range becomes a reachable proxy target. There is no
# allow-list form: no CIDR variable, no per-host exception. Development only.
#
# The server and the broker each read it for their own outbound calls, and
# setting it on one does nothing for the other. An upstream on a private address
# needs it in both. See docs/configuration.md#the-ssrf-guard-is-two-variables.
AGTCRDN_PROXY_ALLOW_LOOPBACK=false

# ── Template override directories ───────────────────────────────────────────
# The credential, MCP and policy catalogs are compiled into the binary from
# data/. Each of these names a directory of extra JSON templates merged with the
# built-in set at startup; a template whose key matches a built-in replaces it.
# AGTCRDN_MCP_TEMPLATES_DIR is the only supported way to put your own MCP server
# in the marketplace. The directories are read ONCE at startup — restart the
# server after adding or editing a template.
AGTCRDN_MCP_TEMPLATES_DIR=
AGTCRDN_CREDENTIAL_TEMPLATES_DIR=
AGTCRDN_POLICY_TEMPLATES_DIR=

# Label used in OAuth Dynamic Client Registration requests as `client_name`.
# Defaults to "AgentCordon". Useful when several AgentCordon instances register
# with the same upstream provider.
AGTCRDN_INSTANCE_LABEL=AgentCordon

# ── Broker (agentcordon-broker; not read by the server) ─────────────────────

AGTCRDN_SERVER_URL=http://localhost:3140  # Server the broker talks to

# Listen port. 0 (the default) means "pick a free port and write the URL to
# ~/.agentcordon/broker.port", which is how the CLI discovers the broker. Set a
# fixed port only if something outside the CLI needs a known address.
AGTCRDN_BROKER_PORT=0

# Directory for the broker's keys, tokens and runtime files — broker.key,
# tokens.enc, workspaces.json, broker.port, broker.pid, broker.lock. Defaults to
# ~/.agentcordon. The CLI does NOT read this variable: a broker on a non-default
# data directory is invisible to CLI auto-discovery and every CLI invocation
# then needs AGTCRDN_BROKER_URL pointed at it.
AGTCRDN_DATA_DIR=

AGTCRDN_BROKER_BIND=127.0.0.1             # Bind address; non-loopback needs TLS or a shared secret
AGTCRDN_BROKER_SHARED_SECRET=             # Required for a non-loopback bind without TLS; the CLI reads it too
AGTCRDN_BROKER_TLS_CERT=                  # PEM chain; with _TLS_KEY the broker serves HTTPS itself
AGTCRDN_BROKER_TLS_KEY=                   # PEM private key
AGTCRDN_MCP_SYNC_INTERVAL=60              # MCP config sync interval in seconds
AGTCRDN_TOKEN_TTL_BUFFER=60               # Seconds before expiry the broker refreshes its access token

# ── CLI (agentcordon) ───────────────────────────────────────────────────────

# Override broker discovery. Normally unset — the CLI reads
# ~/.agentcordon/broker.port. Only plain http:// to a loopback host, or any
# https:// URL, is accepted.
AGTCRDN_BROKER_URL=
AGTCRDN_BROKER_CA=                        # Extra PEM trust anchor for a TLS broker's own certificate
AGTCRDN_WORKSPACE_DIR=                    # Where the CLI looks for .agentcordon/ (default: the current directory)

# ── Not environment variables ───────────────────────────────────────────────
# OAuth provider clients — the client_id and client_secret AgentCordon presents
# to an upstream authorization server — are managed in
# Settings > MCP Identity > OAuth Provider Clients in the admin console and
# stored encrypted in the database. See docs/granting-mcp-server-access.md.
