# AgentCordon — Environment Variables
#
# Copy this file to .env and customize as needed.
# All variables are optional — the server auto-generates secrets on first run.

# ── Server ──────────────────────────────────────────────────────────────────
# Address and port the server binds. This is the server's listen setting.
AGTCRDN_LISTEN_ADDR=0.0.0.0:3140
# Host-side port for the shipped docker-compose.yml port mapping
# ("${AGTCRDN_PORT:-3140}:3140"). The server binary does NOT read this — a
# plain `docker run` or a bare binary ignores it. Use AGTCRDN_LISTEN_ADDR to
# change the port the server itself listens on.
AGTCRDN_PORT=3140
# SQLite database path. SQLite is the only storage backend; the PostgreSQL
# one was removed in 0.4.0, and AGTCRDN_DB_TYPE / AGTCRDN_DB_URL are no
# longer read — a server started with either set refuses to boot.
AGTCRDN_DB_PATH=./data/agent-cordon.db
# Master encryption key (auto-generated if empty). Minimum 16 characters.
# A secret carrying at least 32 bytes of random material (64 hex chars, base64
# of 32+ bytes, or 32+ characters at 4+ bits of Shannon entropy per byte) is
# used as-is. Anything weaker is stretched with Argon2id using a random salt
# persisted at <db dir>/.master-salt — but only on a fresh install, so an
# upgrade of an install that already holds credentials keeps its key and logs
# a warning instead. See docs/master-key.md.
AGTCRDN_MASTER_SECRET=
# Version number of AGTCRDN_MASTER_SECRET. Every encrypted row records the
# version it was sealed under. Leave at 1 until the first rotation; bump it
# by one each time the master secret changes. See docs/master-key.md.
AGTCRDN_MASTER_KEY_VERSION=1
# The secret for version AGTCRDN_MASTER_KEY_VERSION - 1. Set only during a
# rotation, so rows sealed under the old secret still open until
# POST /api/v1/admin/rotate-key has re-sealed them; then remove it.
# Must differ from AGTCRDN_MASTER_SECRET.
AGTCRDN_PREVIOUS_MASTER_SECRET=

# Argon2id cost for password hashing, secret hashing, and master-secret
# stretching. Defaults are the production values below; lower them only for
# constrained hardware, never for convenience.
AGTCRDN_ARGON2_M_COST_KIB=65536           # Memory cost in KiB (default: 65536 = 64 MiB)
AGTCRDN_ARGON2_T_COST=3                   # Iterations (default: 3)
AGTCRDN_ARGON2_P_COST=4                   # Lanes (default: 4)

# Replica guard. The server keeps policy, rate-limit and SSE state in memory,
# so a second process over the same SQLite file enforces a different picture of
# the world. Startup takes an advisory lock on <db path>.lock and refuses to
# start when another process holds it. Set to `unsafe-shared` to skip the guard
# and accept split-brain enforcement. Values: single (default) | unsafe-shared.
AGTCRDN_REPLICA_MODE=single
AGTCRDN_ROOT_USERNAME=                    # Admin username (auto-generated if empty)
AGTCRDN_ROOT_PASSWORD=                    # Admin password (auto-generated, printed on first boot)
# The URL your users reach this server on, e.g. https://agentcordon.example.com.
# Everything absolute the server hands out is built from it: the RFC 8628 device
# flow's activation URL that `agentcordon register` prints, the OAuth2 MCP
# callback redirect URI, and the `GET /install.sh` script. Leave it unset and
# the fallbacks differ, neither of them good:
#   - the activation URL and the OAuth2 redirect URI use
#     "http://" + AGTCRDN_LISTEN_ADDR, which in a container is
#     http://0.0.0.0:3140 — an address no browser can open;
#   - /install.sh and /install.ps1 use the Host header of the request that
#     fetched them, with the scheme taken from X-Forwarded-Proto and defaulting
#     to http, because this server never terminates TLS itself.
# Behind a TLS-terminating reverse proxy, either set this variable or make the
# proxy send "X-Forwarded-Proto: https"; otherwise the installer it serves
# points at http://. Set it before anyone enrolls a workspace.
AGTCRDN_BASE_URL=
AGTCRDN_SESSION_TTL=28800                 # Session TTL in seconds (default: 8 hours)

# Trust X-Forwarded-For as the client address for per-address limits (login
# lockout, device-code approval). Only behind a reverse proxy that overwrites
# the header. Default: false.
AGTCRDN_TRUST_FORWARDED_HEADERS=false

# ── Logging ─────────────────────────────────────────────────────────────────
AGTCRDN_LOG_LEVEL=info                    # Logging level (trace, debug, info, warn, error; default: info)
AGTCRDN_LOG_FORMAT=json                   # Log output format (json or pretty)

# ── Proxy ───────────────────────────────────────────────────────────────────
# Turns the SSRF guard OFF — not just the loopback rule. With this set, every
# private and reserved range becomes a reachable proxy target: RFC 1918, CGNAT
# (100.64/10), link-local (169.254/16), 0/8, 192.0.0/24, 198.18/15, the
# TEST-NETs, multicast, 240/4, NAT64 64:ff9b::/96, and 6to4. Development only;
# never in production.
#
# Read by BOTH processes, each for its own outbound calls, and setting it on
# one does nothing for the other:
#   broker — agentcordon proxy (/proxy) and agentcordon mcp-call
#   server — MCP tool discovery (the tools/list probe a marketplace install
#            runs) and OAuth discovery (the MCP 401 probe, the RFC 9728
#            protected-resource document, the RFC 8414 AS metadata)
# An upstream on a private or loopback address needs it in both: without the
# broker's copy the proxy call is refused; without the server's, a marketplace
# install reports success and discovers no tools.
#
# There is no allow-list form — no CIDR variable, no per-host exception. The
# guard is all-or-nothing.
AGTCRDN_PROXY_ALLOW_LOOPBACK=false

# ── OAuth ───────────────────────────────────────────────────────────────────
AGTCRDN_AUTH_CODE_TTL=600                 # Authorization code TTL in seconds (default: 600)

# ── Device Authorization Grant (RFC 8628) ──────────────────────────────────
# Device code TTL in seconds. Default 600 (10 minutes). Clamped to 30–3600.
AGTCRDN_DEVICE_CODE_TTL_SECS=600
# Polling interval the broker uses while awaiting approval, in seconds.
# Default 5. Clamped to 1–60.
AGTCRDN_DEVICE_CODE_POLL_INTERVAL_SECS=5

# ── Broker (agentcordon-broker; not read by the server) ─────────────────────
# Listen port. 0 (the default) means "pick a free port and write the URL to
# ~/.agentcordon/broker.port", which is how the CLI discovers the broker. Set a
# fixed port only if something outside the CLI needs to dial a known address.
AGTCRDN_BROKER_PORT=0
AGTCRDN_SERVER_URL=http://localhost:3140  # Server the broker talks to
# Directory for the broker's keys, tokens and runtime files — broker.key,
# tokens.enc, workspaces.json, broker.port, broker.pid, broker.lock. Defaults
# to ~/.agentcordon. Equivalent to `agentcordon-broker --data-dir`. Set it for
# a second broker on the same host, a service account with no home directory,
# or an XDG-tidy install.
#
# The CLI does NOT read this variable: it always looks for
# ~/.agentcordon/broker.port. A broker on a non-default data directory is
# therefore invisible to CLI auto-discovery, and every CLI invocation needs
# AGTCRDN_BROKER_URL pointed at the broker's actual URL.
AGTCRDN_DATA_DIR=
AGTCRDN_BROKER_BIND=127.0.0.1             # Bind address; non-loopback needs TLS or a shared secret
AGTCRDN_BROKER_SHARED_SECRET=             # Required for a non-loopback bind without TLS; the CLI reads it too
AGTCRDN_BROKER_TLS_CERT=                  # PEM chain; with _TLS_KEY the broker serves HTTPS itself
AGTCRDN_BROKER_TLS_KEY=                   # PEM private key
AGTCRDN_MCP_SYNC_INTERVAL=60              # MCP config sync interval in seconds (default: 60)

# ── CLI (agentcordon) ───────────────────────────────────────────────────────
# Override broker discovery. Normally unset — the CLI reads
# ~/.agentcordon/broker.port. Only plain http:// to a loopback host, or any
# https:// URL, is accepted.
AGTCRDN_BROKER_URL=
AGTCRDN_BROKER_CA=                        # Extra PEM trust anchor for a TLS broker's own certificate

# ── OAuth Dynamic Client Registration ───────────────────────────────────────
# Optional: label used in OAuth Dynamic Client Registration requests as `client_name`.
# Defaults to "AgentCordon" if not set. Useful when multiple AgentCordon instances
# register with the same provider (e.g., Notion, GitHub, Slack).
# AGTCRDN_INSTANCE_LABEL=

# ── Template override directories ───────────────────────────────────────────
# The credential, MCP and policy catalogs are compiled into the binary from
# data/. Each of these names a directory of extra JSON templates merged with the
# built-in set at startup; a template whose key matches a built-in replaces it.
# AGTCRDN_MCP_TEMPLATES_DIR is the only supported way to put your own MCP server
# in the marketplace. The directories are read ONCE at startup — restart the
# server after adding or editing a template.
AGTCRDN_MCP_TEMPLATES_DIR=
AGTCRDN_CREDENTIAL_TEMPLATES_DIR=
AGTCRDN_POLICY_TEMPLATES_DIR=

# ── MCP OAuth Apps ──────────────────────────────────────────────────────────
# OAuth app credentials (client_id / client_secret) for MCP servers are
# configured in Settings > MCP OAuth Apps in the web UI, NOT via env vars.
# They are stored encrypted in the database.
