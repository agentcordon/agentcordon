{
  "key": "_blank_aws",
  "name": "Custom (AWS)",
  "service": "aws",
  "credential_type": "aws",
  "auth_type": "aws_sigv4",
  "header": "Authorization: AWS4-HMAC-SHA256",
  "allowed_url_pattern": "https://**.amazonaws.com/*",
  "fields": [
    {
      "key": "aws_access_key_id",
      "label": "Access Key ID",
      "placeholder": "AKIAIOSFODNN7EXAMPLE",
      "required": true,
      "mono": true
    },
    {
      "key": "aws_secret_access_key",
      "label": "Secret Access Key",
      "placeholder": "Paste your secret access key",
      "required": true,
      "secret": true
    },
    {
      "key": "aws_region",
      "label": "Region",
      "placeholder": "us-east-1",
      "mono": true
    },
    {
      "key": "aws_service",
      "label": "AWS service",
      "placeholder": "s3",
      "mono": true,
      "help": "The AWS service the signature is scoped to (e.g. s3, execute-api). Not the credential's own Service above. Optional."
    }
  ],
  "description": "Default fields for a blank AWS credential.",
  "tags": [],
  "sort_order": 9999
}
