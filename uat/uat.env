# Single source of truth for the UAT topology. Sourced by run.sh (bash) and
# parsed by the Playwright helper (tests/helpers/env.ts). Plain KEY=VALUE only,
# no quoting, no expansion.
UAT_PREFIX=agentcordon-uat
UAT_NETWORK=agentcordon-uat-net
UAT_VOLUME=agentcordon-uat-data
UAT_SERVER=agentcordon-uat-server
UAT_SERVER2=agentcordon-uat-server2
UAT_UPSTREAM=agentcordon-uat-upstream
UAT_BROKER=agentcordon-uat-broker
UAT_CLI=agentcordon-uat-cli
UAT_SERVER_IMAGE=agentcordon-uat-server:latest
UAT_TOOLS_IMAGE=agentcordon-uat-tools:latest
# Every stand-in service (mock upstream, mock IdP, mock MCP server) runs on
# this image. Pinned to a minor version so a `python:3-slim` retag cannot
# change what the harness ran on between two runs; uat/artifacts/provenance.json
# records the digest that was actually pulled.
UAT_PYTHON_IMAGE=python:3.12-slim
UAT_HOST_PORT=13140
UAT_SERVER_URL=http://127.0.0.1:13140
UAT_ROOT_USERNAME=root
UAT_ROOT_PASSWORD=Uat-R00t-P4ssw0rd-2026-agentcordon
UAT_MASTER_SECRET=9f3c1a7e2b8d40556677889900aabbccddeeff112233445566778899aabbccdd
UAT_BROKER_SHARED_SECRET=uat-broker-shared-secret-4f8a2c9e1b
UAT_WORKSPACE_NAME=uat-ws
UAT_CREDENTIAL_NAME=upstream-token
UAT_CREDENTIAL_SECRET=uat-secret-value-123456
UAT_CREDENTIAL_PATTERN=http://upstream:8080/*

# --- S11-S16: OAuth provider, MCP server, AWS ------------------------------
# The mock IdP and the mock MCP server run in the SERVER container's network
# namespace, so the server reaches them on 127.0.0.1 (which is what both the
# credential API's token-endpoint check and oauth_discovery require of a
# plain-HTTP provider), the broker reaches them at server:<port>, and the host
# browser reaches them on the ports the server container publishes.
UAT_IDP=agentcordon-uat-idp
UAT_MCP=agentcordon-uat-mcp
UAT_IDP_PORT=9000
UAT_IDP_NODCR_PORT=9001
UAT_MCP_PORT=9100
UAT_IDP_URL=http://127.0.0.1:9000
UAT_IDP_NODCR_URL=http://127.0.0.1:9001
UAT_MCP_URL=http://127.0.0.1:9100
UAT_MCP_UPSTREAM_HOST=http://server:9100
UAT_BASE_URL=http://127.0.0.1:13140
UAT_IDP_DELEGATED_TTL=100
UAT_IDP_SUBJECT=uat-delegated-user@example.test
UAT_MCP_API_KEY=uat-mcp-api-key-7c1f9a
# S11 - oauth2_client_credentials (application credential)
UAT_OAUTH_CC_NAME=uat-app-token
UAT_OAUTH_CC_CLIENT_ID=uat-app-client
UAT_OAUTH_CC_CLIENT_SECRET=uat-app-client-secret
UAT_OAUTH_CC_SHORT_NAME=uat-app-token-short
UAT_OAUTH_CC_SHORT_CLIENT_ID=uat-app-client-short
UAT_OAUTH_CC_SHORT_CLIENT_SECRET=uat-app-client-short-secret
UAT_OAUTH_CC_PATTERN=http://upstream:8080/oauth-api*
# S12b - the manual provider client at the no-DCR listener
UAT_OAUTH_MANUAL_CLIENT_ID=uat-manual-client
UAT_OAUTH_MANUAL_CLIENT_SECRET=uat-manual-client-secret
# S14 - AWS SigV4
UAT_AWS_NAME=uat-aws-api
UAT_AWS_ACCESS_KEY_ID=AKIAUATEXAMPLE
UAT_AWS_SECRET_ACCESS_KEY=uat-aws-secret-key-value
UAT_AWS_REGION=us-east-1
UAT_AWS_SERVICE=execute-api
UAT_AWS_PATTERN=http://upstream:8080/*
# S16 - a second workspace, to show an MCP is not reachable from a workspace
# it is not bound to
UAT_WORKSPACE2_NAME=uat-ws-2
UAT_WORKSPACE2_DIR=/home/uat/workspace2
# S17 - vaults: a vault of one's own, and a second person to share it with.
UAT_VAULT_NAME=uat-vault
UAT_VAULT_RENAMED=uat-vault-renamed
UAT_VAULT_CREDENTIAL_NAME=uat-vault-cred
UAT_VAULT_CREDENTIAL_SECRET=uat-vault-secret-9d3f21
UAT_SHARE_USERNAME=uat-colleague
UAT_SHARE_PASSWORD=uat-colleague-password-1
# S17 - the operator account that must see the provider-client listing
# read-only (Change 2: provider-client writes are admin-only).
UAT_OPERATOR_USERNAME=uat-operator
UAT_OPERATOR_PASSWORD=uat-operator-password-1
