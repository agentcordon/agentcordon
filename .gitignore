# Rust
/target/
**/*.rs.bk

# SQLite databases (but not data-defined template files)
/data/*.db
/data/*.db-wal
/data/*.db-shm
*.db
*.db-wal
*.db-shm

# Environment / secrets
.env
*.pem
*.key

# Node
node_modules/
package-lock.json

# Claude Code (local settings are per-machine, agents/commands are shared)
.claude/settings.local.json

# UX audit output (generated, screenshots)
docs/ux-audit/

# Enterprise-only docs (exclude from public repo)
docs/backlog-enterprise.md

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Docker
docker-compose.override.yml

# Test artifacts
/tmp/
*.png
tools/__pycache__/
/test-results/

# Dolt database files (added by bd init)
.dolt/

# AgentCordon workspace identity
.agentcordon/
.mcp.json
AGENTS.md
.claude

# Python bytecode
__pycache__/
*.pyc

# Working notes, session scratch, plugin state (never part of the public repo)
.scratch/
.agents/
skills-lock.json

# Server runtime state (written beside the database on first boot)
.master-salt
.secret
.root_password
*.db.lock

# UAT: everything generated by a run lives under uat/artifacts (see uat/.gitignore)
uat/artifacts/
uat/agent-workspace/

# Committed test fixtures, even where their extension is ignored above
!crates/server/tests/fixtures/**
!crates/broker/tests/fixtures/**

# The harness's Playwright lockfile pins the browser driver; keep it
!uat/playwright/package-lock.json
